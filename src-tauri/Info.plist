<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the app bundle's Info.plist by tauri-build. WKWebView's
     getUserMedia (voice-note recording) hard-crashes the app on macOS if
     the mic usage description is missing. -->
<plist version="1.0">
<dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>AgentGram uses the microphone to record voice notes.</string>
</dict>
</plist>
